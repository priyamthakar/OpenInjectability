# Bytecode / caches
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/
.coverage.*

# Build artifacts (wheels, sdists, eggs)
build/
dist/
*.egg
*.eggs/
*.whl
pip-wheel-metadata/

# Local environments
.venv/
venv/
.env

# OS / editor
.DS_Store
Thumbs.db
.idea/
.vscode/

# Local run outputs (CLI smoke / ad-hoc assessments at repo root)
/assessment.json
/assessment.md
/assessment.html
/assessment.pdf
/force-vs-needle.png
/audit.zip
/output/
/tmp/

# Ad-hoc plots under repo root only; keep docs and validation trees
/*.png

# Agent scrape temp downloads (do not commit)
docs/_tmp_*/
docs/_tmp_*
docs/_fulltext_xml/
docs/_repo_deep_pull_raw.json
docs/pdf_extract/images/
docs/_verwulgen2018_author.pdf

# User-supplied literature PDFs (keep local; large binaries)
/*.pdf
/PhD_Thesis_*.pdf
allmendinger2014.pdf
verwulgen2018.pdf
zhang2018.pdf

# Explicitly keep experimental validation comparison reports (json/md/sha256)
# even if broader ignore patterns are added later.
!validation/experimental/reports/
!validation/experimental/reports/**
!validation/experimental/*.json
!validation/experimental/README.md
!validation/experimental/schema.json
!validation/experimental/panel.template.json
